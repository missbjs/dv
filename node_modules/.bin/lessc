#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*) basedir=`cygpath -w "$basedir"`;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/mnt/d/Developments/tslib/node_modules/.pnpm/less@4.6.7/node_modules/less/bin/node_modules:/mnt/d/Developments/tslib/node_modules/.pnpm/less@4.6.7/node_modules/less/node_modules:/mnt/d/Developments/tslib/node_modules/.pnpm/less@4.6.7/node_modules:/mnt/d/Developments/tslib/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/mnt/d/Developments/tslib/node_modules/.pnpm/less@4.6.7/node_modules/less/bin/node_modules:/mnt/d/Developments/tslib/node_modules/.pnpm/less@4.6.7/node_modules/less/node_modules:/mnt/d/Developments/tslib/node_modules/.pnpm/less@4.6.7/node_modules:/mnt/d/Developments/tslib/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../../node_modules/.pnpm/less@4.6.7/node_modules/less/bin/lessc" "$@"
else
  exec node  "$basedir/../../../node_modules/.pnpm/less@4.6.7/node_modules/less/bin/lessc" "$@"
fi
