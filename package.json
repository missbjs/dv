{
  "name": "@missbjs/dv",
  "version": "1.0.1",
  "type": "module",
  "description": "Chrome DevTools Protocol CLI - A comprehensive TypeScript CLI tool for browser automation, testing, and debugging",
  "license": "ISC",
  "author": "missbjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/missbjs/dv"
  },
  "homepage": "https://github.com/missbjs/dv#readme",
  "bugs": {
    "url": "https://github.com/missbjs/dv/issues"
  },
  "keywords": [
    "chrome",
    "devtools",
    "cdp",
    "cli",
    "browser-automation",
    "testing",
    "debugging",
    "selenium-alternative",
    "puppeteer-alternative",
    "playwright-alternative",
    "chrome-devtools-protocol",
    "headless-browser",
    "network-monitoring",
    "dom-manipulation",
    "device-emulation"
  ],
  "bin": {
    "dv": "./dist/cli.js",
    "dv1": "./bin/dv1.cjs",
    "dv2": "./bin/dv2.cjs",
    "dv3": "./bin/dv3.cjs",
    "dv4": "./bin/dv4.cjs",
    "dv5": "./bin/dv5.cjs",
    "dv6": "./bin/dv6.cjs"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "dev:watch": "tsx watch src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/ws": "^8.5.12",
    "@vitest/ui": "^4.1.9",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "QUICK-REFERENCE.md",
    "EXAMPLES.md"
  ]
}
