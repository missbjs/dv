{
  "name": "@missbjs/dv",
  "version": "1.0.7",
  "type": "module",
  "description": "Chrome DevTools Protocol CLI - A comprehensive TypeScript CLI tool for browser automation, testing, and debugging",
  "license": "ISC",
  "author": "missbjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/missbjs/dv"
  },
  "homepage": "https://github.com/missbjs/dv#readme",
  "bugs": {
    "url": "https://github.com/missbjs/dv/issues"
  },
  "keywords": [
    "chrome",
    "devtools",
    "cdp",
    "cli",
    "browser-automation",
    "testing",
    "debugging",
    "selenium-alternative",
    "puppeteer-alternative",
    "playwright-alternative",
    "chrome-devtools-protocol",
    "headless-browser",
    "network-monitoring",
    "dom-manipulation",
    "device-emulation"
  ],
  "bin": {
    "dv": "./dist/cli.js",
    "dv1": "./bin/dv1.cjs",
    "dv2": "./bin/dv2.cjs",
    "dv3": "./bin/dv3.cjs",
    "dv4": "./bin/dv4.cjs",
    "dv5": "./bin/dv5.cjs",
    "dv6": "./bin/dv6.cjs"
  },
  "scripts": {
    "build": "npm version patch --no-git-tag-version && tsc",
    "release": "git push && npm version patch --no-git-tag-version && pnpm build && npm publish --access public",
    "dev": "tsx src/cli.ts",
    "dev:watch": "tsx watch src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "ws": "^8.21.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "@vitest/ui": "^4.1.10",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "QUICK-REFERENCE.md",
    "EXAMPLES.md"
  ]
}
