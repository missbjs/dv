{
  "name": "@missbjs/dv",
  "version": "1.0.0",
  "type": "module",
  "description": "Chrome DevTools Protocol CLI - A comprehensive TypeScript CLI tool for browser automation, testing, and debugging",
  "license": "ISC",
  "author": "missbjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/missbjs/dv"
  },
